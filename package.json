{
  "name": "youtube-organizer",
  "private": true,
  "version": "0.0.0",
  "description": "YouTube Playlist Organizer Web & Desktop App",
  "author": "Thomas M. Brown",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:start": "electron electron/main.cjs",
    "electron:build:win": "vite build && electron-packager . \"YT-Playlist-Organizer\" --platform=win32 --arch=x64 --out=release --overwrite",
    "electron:build:mac": "vite build && electron-packager . \"YT-Playlist-Organizer\" --platform=darwin --arch=universal --out=release --overwrite"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^31.3.0",
    "electron-packager": "^17.1.2",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.thomasmbrown.youtubeorganizer",
    "productName": "YT Playlist Organizer",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
